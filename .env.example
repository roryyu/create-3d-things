# ---- Database ----
# PostgreSQL 连接串；?schema= 指定本项目专属 schema（所有表建在该 schema 下，
# schema 需已存在，migrate deploy 不会自动创建）
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=create3d"

# ---- Auth ----
# JWT 签名密钥（必需：未设置时服务端启动即报错；生产环境务必换成强随机值）
AUTH_SECRET="your-secret-key-change-this-in-production"
# 站点根地址：nuxt-auth baseURL，以及找回密码邮件中重置链接的前缀
AUTH_ORIGIN="http://localhost:3000"

# ---- DashScope（阿里云百炼，OpenAI 兼容模式）----
# 获取地址: https://dashscope.console.aliyun.com/
# 文字建模调用大模型的必需密钥，未设置时生成接口直接报错
DASHSCOPE_API_KEY="your-dashscope-api-key"
# OpenAI 兼容端点：默认官方地址，可替换为自建网关 / 代理
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# ---- 模型选择（以下三项均有代码内默认值，按需覆盖）----
# 图片输入使用的视觉模型
QWEN_MODEL="qwen-vl-max"
# 长提示词（≥200 字符）使用的文档模型
QWEN_DOC_MODEL="qwen3-max"
# 短提示词（<200 字符）使用的轻量模型，延迟更低
QWEN_FLASH_MODEL="qwen-flash"
